# GEHC PHTC Test Application Environment Configuration

# Serial Port Configuration
GEHC_SERIAL_PORT=COM3
GEHC_BAUDRATE=115200
GEHC_TIMEOUT=2.0

# Application Configuration
GEHC_CONFIG_FILE=gehc_phtc_test/config/config.json
GEHC_COMMAND_PROFILE=full_test
GEHC_LOG_LEVEL=INFO

# Development Settings
GEHC_DEBUG=false
GEHC_VERBOSE=false
GEHC_SIMULATION_MODE=false

# Logging Configuration
GEHC_LOG_DIR=logs
GEHC_LOG_FILE=gehc_phtc_test.log
GEHC_RESPONSE_LOG=responses.json

# Testing Configuration
GEHC_TEST_TIMEOUT=300
GEHC_STOP_ON_ERROR=false
GEHC_ENABLE_PROGRESS_BAR=true

# Display Configuration
GEHC_CONSOLE_WIDTH=120
GEHC_COLOR_SCHEME=dark
GEHC_SHOW_HEX_DATA=true
GEHC_SHOW_TIMESTAMPS=true

# Performance Configuration
GEHC_COMMAND_BATCH_SIZE=10
GEHC_INTER_COMMAND_DELAY=0.5
GEHC_MAX_RETRIES=3

# Security Configuration
GEHC_VALIDATE_RESPONSES=true
GEHC_CHECKSUM_VERIFICATION=true
GEHC_AUDIT_TRAIL=true

# Database Configuration (Future)
# GEHC_DATABASE_URL=sqlite:///gehc_phtc_test.db
# GEHC_DATABASE_ECHO=false

# External Services Configuration (Future)
# GEHC_MQTT_BROKER=localhost
# GEHC_MQTT_PORT=1883
# GEHC_API_BASE_URL=http://localhost:8000

# Development Tools
PYTHONPATH=.
PYTEST_CURRENT_TEST=
COVERAGE_CORE=sysmon