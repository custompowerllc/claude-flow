  "test_sections": {
    "section_1": {
      "title": "Final Test with covered Pack",
      "description": "Final testing procedure for the battery pack in its covered/enclosed state"
    },
    "section_2": {
      "title": "Equipment, Tools, Materials",
      "required_equipment": [
        {
          "item": "Computer",
          "specifications": "With 'Easy Modbus Client' software",
          "purpose": "MODBUS communication interface"
        },
        {
          "item": "ZHB-FX0926",
          "specifications": "Test Harness for RS232 and Pack+/-",
          "purpose": "Interface between computer and battery pack"
        },
        {
          "item": "Power Supply",
          "specifications": "Agilent U8002A, 30V/5A, ID#156",
          "purpose": "Charging power source"
        },
        {
          "item": "Electronic Load",
          "specifications": "BK8500, 300W, ID#353", 
          "purpose": "Discharge load testing"
        }
      ]
    },
    "section_3": {
      "title": "Test Setup",
      "setup_steps": [
        {
          "step": "3.1",
          "action": "Connect computer USB to ZHB-FX0926",
          "purpose": "Establish communication link"
        },
        {
          "step": "3.2", 
          "action": "Connect the Load to ZHB-FX0926 Pack+/-",
          "purpose": "Connect discharge load"
        },
        {
          "step": "3.3",
          "action": "Set Power Supply to 28.4V 5A",
          "purpose": "Configure charging voltage and current"
        }
      ],
      "test_setup_image_included": true
    },
    "section_4": {
      "title": "Verify MODBUS Communication",
      "communication_setup": {
        "signal_ground": {
          "step": "4.1",
          "action": "Set SIGNAL_GND Switch to ON",
          "note": "button depressed at maximum extension"
        },
        "port_identification": {
          "step": "4.2", 
          "action": "Identify the COM port # via Device Manager/Ports"
        },
        "software_startup": {
          "step": "4.3",
          "action": "Start up 'Easy Modbus Client'"
        }
      },
      "modbus_settings": {
        "protocol": "ModbusRTU (Serial)",
        "port": "COM8",
        "baudrate": 9600,
        "parity": "None", 
        "stopbits": 1,
        "slave_id": "As selected",
        "connection_verification": "ModbusRTU (Serial) must be selected before connecting"
      },
      "communication_tests": [
        {
          "test": "4.2",
          "description": "Initial communication test",
          "parameters": {
            "command": "FC3",
            "starting_address": 16,
            "number_of_values": 2
          },
          "expected_result": "7-byte stream output",
          "success_criteria": "Command executes successfully"
        },
        {
          "test": "4.3",
          "description": "State of Charge reading",
          "parameters": {
            "starting_address": 64,
            "command": "FC3"
          },
          "expected_result": "3rd byte from 7-byte output ≤ 1E (30%)",
          "note": "Example shown: 1A = 26%"
        }
      ],
      "software_interface": {
        "read_functions": [
          "Read Coils - FC1",
          "Read Discrete Inputs - FC2", 
          "Read Holding Registers - FC3",
          "Read Input Registers - FC4"
        ],
        "write_functions": [
          "Write Single Coil - FC5",
          "Write Single Register - FC6",
          "Write Multiple Coils - FC15",
          "Write Multiple Registers - FC16"
        ]
      }
    },
    "section_5": {
      "title": "Electrical Test - Manual",
      "test_procedures": [
        {
          "step": "5.1",
          "description": "Verify Pack OCV from Table below",
          "reference": "See test requirements table"
        },
        {
          "step": "5.2", 
          "description": "Pack Enable Function",
          "procedure": "Press-hold the Pack_Enable button, and the Pack Voltage will show up. Release the Pack_Enable button, and the Pack Voltage will drop to 0V."
        },
        {
          "step": "5.3",
          "description": "Charge Acceptance",
          "procedure": "Charge at 5A to 28.4V for 15 secs"
        },
        {
          "step": "5.4",
          "description": "Discharge Function", 
          "procedure": "Set the load to discharge at 5A. Verify discharging occurs for 15 seconds."
        }
      ],
      "test_requirements": [
        {
          "test_number": 1,
          "test_name": "Pack Open Circuit Voltage",
          "requirements": "OCV ≥ 25V"
        },
        {
          "test_number": 2,
          "test_name": "Charge Acceptance: 28.4V, 10A",
          "requirements": "29V ≤ Vbat ≤ 29.4V and 9.9A ≤ Ibat ≤ 10.1A"
        },
        {
          "test_number": 3,
          "test_name": "Discharge Function: 20A",
          "requirements": "20V ≤ Vbat ≤ 28.4V and -19.6A ≤ Ibat ≤ -20.4A"
        },
        {
          "test_number": 4,
          "test_name": "Peak Discharge Function: 45A, 5 sec",
          "requirements": "TBD - not specified in document"
        },
        {
          "test_number": 5,
          "test_name": "Discharge Overcurrent 1: 47A, 10 seconds", 
          "requirements": "TBD - not specified in document"
        }
      ],
      "testing_notes": [
        "Reduced Load testing to Prevent SOC (25%) dropping to 0% if Pack Voltage hits 24V"
      ]
    }
  },
